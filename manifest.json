{
  "manifest_version": 2,
  "name": "Game Shelf – Price Watch",
  "version": "1.0.21",
  "description": "Track prices and stock across your favourite stores—for games, books, films and more.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{424837e0-506c-4e1a-a0cc-a1a348cdbe45}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "activeTab",
    "https://api.frankfurter.dev/*"
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Game Shelf – Price Watch",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "96": "icon.png"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "content_security_policy": "script-src 'self'; object-src 'none'",
  "optional_permissions": [
    "https://*/*",
    "downloads"
  ],
  "incognito": "not_allowed"
}
